#
# vendor props for judyln
#

# Audio
ro.hardware.audio.primary=judyln

# Bluetooth
bluetooth.device.default_name=LG G7 ThinQ

# Camera
vendor.lge.faceprint.use.camera=0
ro.vendor.lge.logical.camera=1
ro.vendor.lge.physical.camera=3

# Fingerprint
persist.vendor.fingerprint.type=rear

# FM
# Gain factors used by the prebuilt audio HAL when it computes the FM RX volume
# control: value = round(stream_volume * 8192 * factor). 1.0 is the maximum
# usable value, the mixer control saturates at 8192 (INT_RX_VOL_GAIN).
vendor.lge.fm_gain_control_speaker=1.0
vendor.lge.fm_gain_control_headset=1.0
vendor.lge.fm_gain_control_factor=1.0

# Misc
ro.vendor.lge.build.target_country=COM
ro.vendor.lge.build.target_operator=LAO
ro.vendor.lge.capp_cupss.rootdir=/oem/OP
ro.vendor.lge.swversion=G71030e

# USB
vendor.usb.product_string=LG G7 ThinQ
